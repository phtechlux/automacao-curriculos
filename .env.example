# Uso pessoal (local): sem chave, a IA usa o Claude Code instalado (claude -p), sem custo extra.
# Produto (hospedado, multiusuário): defina ANTHROPIC_API_KEY sempre — nunca depender do claude -p.
ANTHROPIC_API_KEY=
CLAUDE_CLI_MODEL=sonnet
GMAIL_CREDENTIALS_PATH=credentials.json
CLAUDE_MODEL=claude-sonnet-5-5

# Hospedagem do painel (Fase 7). Local: deixe em branco (usa 127.0.0.1:8765).
HOST=
PORTA=

# Webhook da Kiwify (Fase 6). Defina o mesmo segredo na URL configurada no painel da
# Kiwify: https://seuservidor/webhook/kiwify?secret=<KIWIFY_WEBHOOK_SECRET>
KIWIFY_WEBHOOK_SECRET=
KIWIFY_CREDITOS_PADRAO=10
